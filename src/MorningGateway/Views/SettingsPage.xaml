<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MorningGateway.ViewModels"
             xmlns:models="clr-namespace:MorningGateway.Models"
             x:Class="MorningGateway.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="22">

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Appearance" Style="{StaticResource HeadingLabel}" FontSize="18" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Theme" VerticalOptions="Center" />
                        <Picker Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding ThemeModeText}" WidthRequest="140" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Use Fahrenheit" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding Settings.UseFahrenheit}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Keep screen on" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding Settings.KeepScreenOn}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Burn-in protection (pixel shift)" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding Settings.BurnInProtectionEnabled}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding Settings.BurnInIntervalSeconds, StringFormat='Shift every {0}s'}" VerticalOptions="Center" />
                        <Stepper Grid.Column="1" Minimum="15" Maximum="300" Increment="15" Value="{Binding Settings.BurnInIntervalSeconds}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Weather -->
            <Border Style="{StaticResource Card}" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Weather location" Style="{StaticResource HeadingLabel}" FontSize="18" />
                    <Label Text="{Binding Settings.WeatherLocationName, StringFormat='Current: {0}'}" Style="{StaticResource SecondaryLabel}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" Placeholder="Search city name" Text="{Binding LocationSearchText}" />
                        <Button Grid.Column="1" Text="Search" Command="{Binding SearchLocationCommand}" />
                    </Grid>

                    <Button Text="Use device location" Style="{StaticResource IconButton}" WidthRequest="220" Command="{Binding UseDeviceLocationCommand}" />

                    <CollectionView x:Name="LocationResultsList" ItemsSource="{Binding LocationResults}" HeightRequest="150"
                                    IsVisible="{Binding LocationResults.Count, Converter={StaticResource CountToBool}}"
                                    SelectionMode="Single" SelectionChanged="OnLocationResultSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:GeocodeResult">
                                <Grid Padding="4,8">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                    <Label Text="{Binding Region}" Style="{StaticResource SecondaryLabel}" FontSize="12" Margin="0,18,0,0" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Calendars -->
            <Border Style="{StaticResource Card}" Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Calendars" Style="{StaticResource HeadingLabel}" FontSize="18" />

                    <CollectionView ItemsSource="{Binding Sources}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CalendarSourceConfig">
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,6">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding DisplayName}" FontAttributes="Bold" />
                                        <Label Text="{Binding TypeLabel}" Style="{StaticResource SecondaryLabel}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="1" IsToggled="{Binding Enabled}" Toggled="OnSourceEnabledToggled" />
                                    <Button Grid.Column="2" Text="Remove" Style="{StaticResource IconButton}" WidthRequest="90" Clicked="OnRemoveSourceClicked" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                    <!-- Add ICS / webcal -->
                    <Label Text="Add an ICS / webcal calendar" FontAttributes="Bold" />
                    <Label Text="Paste Google's 'Secret address in iCal format' or an iCloud public calendar link." Style="{StaticResource SecondaryLabel}" FontSize="12" />
                    <Entry Placeholder="Name (e.g. Family)" Text="{Binding NewIcsName}" />
                    <Entry Placeholder="https://... .ics" Text="{Binding NewIcsUrl}" Keyboard="Url" />
                    <Button Text="Add calendar" HorizontalOptions="Start" Command="{Binding AddIcsSourceCommand}" />

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                    <!-- Add Google -->
                    <Label Text="Add a Google Calendar" FontAttributes="Bold" />
                    <Label Text="Requires an OAuth Client ID from Google Cloud Console - see README 'Google Calendar setup'." Style="{StaticResource SecondaryLabel}" FontSize="12" />
                    <Entry Placeholder="OAuth Client ID" Text="{Binding Settings.GoogleOAuthClientId}" />
                    <Button Text="Connect Google account" HorizontalOptions="Start" Command="{Binding ConnectGoogleCommand}" />

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                    <!-- Add CalDAV -->
                    <Label Text="Add a CalDAV calendar (iCloud, Fastmail, Nextcloud, ...)" FontAttributes="Bold" />
                    <Label Text="iCloud: use an app-specific password from appleid.apple.com, server https://caldav.icloud.com" Style="{StaticResource SecondaryLabel}" FontSize="12" />
                    <Entry Placeholder="Server URL" Text="{Binding NewCalDavServerUrl}" Keyboard="Url" />
                    <Entry Placeholder="Username / Apple ID" Text="{Binding NewCalDavUsername}" />
                    <Entry Placeholder="Password / app-specific password" Text="{Binding NewCalDavPassword}" IsPassword="True" />
                    <Button Text="Find calendars" HorizontalOptions="Start" Command="{Binding DiscoverCalDavCalendarsCommand}" />

                    <CollectionView x:Name="CalDavResultsList" ItemsSource="{Binding DiscoveredCalDavCalendars}"
                                    IsVisible="{Binding DiscoveredCalDavCalendars.Count, Converter={StaticResource CountToBool}}"
                                    SelectionMode="Single" SelectionChanged="OnCalDavCalendarSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:DiscoveredCalendar">
                                <Grid Padding="4,8">
                                    <Label Text="{Binding DisplayName}" FontAttributes="Bold" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}" Style="{StaticResource SecondaryLabel}" HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
