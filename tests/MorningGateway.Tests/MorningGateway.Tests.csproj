<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plain net10.0 test project. The app itself targets net10.0-android and can't
    be referenced from here, so the MAUI-free source files are linked in
    directly and the few MAUI statics they touch (Preferences, SecureStorage,
    WebAuthenticator) are replaced by in-memory shims under Shims/.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>MorningGateway.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Ical.Net" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Maui.Storage" />
    <Using Include="Microsoft.Maui.Authentication" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\MorningGateway\Models\*.cs" />
    <Compile Include="..\..\src\MorningGateway\Services\Calendar\*.cs" />
    <Compile Include="..\..\src\MorningGateway\Services\Net\*.cs" />
    <Compile Include="..\..\src\MorningGateway\Services\Weather\OpenMeteoWeatherService.cs" />
    <Compile Include="..\..\src\MorningGateway\Services\Weather\WeatherCodeInfo.cs" />
    <Compile Include="..\..\src\MorningGateway\Services\Weather\IWeatherService.cs" />
    <Compile Include="..\..\src\MorningGateway\Services\Display\SettingsStore.cs" />
    <Compile Include="..\..\src\MorningGateway\Services\Display\UiScale.cs" />
    <Compile Include="..\..\src\MorningGateway\Services\Updates\UpdateService.cs" />
  </ItemGroup>

</Project>
